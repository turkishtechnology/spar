#!/bin/sh

echo "🔍 Starting pre-commit checks..."

TMPDIR=$(mktemp -d)

pnpm lint-staged >"$TMPDIR/lint.log" 2>&1 &
PID1=$!

pnpm check-types >"$TMPDIR/types.log" 2>&1 &
PID2=$!

FAIL=0
wait $PID1 || FAIL=1
wait $PID2 || FAIL=1

echo "📝 lint-staged:"
cat "$TMPDIR/lint.log"

echo "🔍 check-types:"
cat "$TMPDIR/types.log"

rm -rf "$TMPDIR"

[ $FAIL -eq 0 ] && echo "✅ Pre-commit checks completed!" || exit 1
