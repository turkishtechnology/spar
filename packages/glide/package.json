{
  "name": "@turkish-technology/glide",
  "version": "0.1.0",
  "description": "A modern headless React component library providing unstyled, accessible UI primitives",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run clean && rspack build && tsc --emitDeclarationOnly",
    "dev": "rspack build --watch",
    "prepublishOnly": "pnpm run build && pnpm run check-types && pnpm run lint",
    "prepack": "pnpm run build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPatterns=\"(test|spec)\\.(ts|tsx)$\"",
    "test:integration": "jest --testPathPatterns=\"integration\\.(test|spec)\\.(ts|tsx)$\"",
    "test:a11y-unit": "jest --testPathPatterns=\"a11y\\.(test|spec)\\.(ts|tsx)$\"",
    "size-check": "size-limit"
  },
  "repository": {
    "type": "git",
    "url": "",
    "directory": "packages/glide"
  },
  "author": {
    "name": "Turkish Technology",
    "email": "info@thy.com",
    "url": "https://turkishtechnology.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@rspack/cli": "^1.0.0",
    "@rspack/core": "^1.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "jest": "^30.1.1",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.0.0",
    "ts-jest": "^29.4.1",
    "tslib": "^2.7.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "react",
    "react-components",
    "glide",
    "headless-ui",
    "headless-components",
    "accessible",
    "accessibility",
    "a11y",
    "unstyled",
    "ui-primitives",
    "component-library",
    "typescript",
    "wcag",
    "aria",
    "react-19"
  ],
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.6"
  }
}
